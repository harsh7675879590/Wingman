# Wingman Configuration

PORT=3000

# LLM Provider: 'gemini' | 'openai' | 'mock'
# If left empty, it auto-detects from available keys, or falls back to offline heuristics.
LLM_PROVIDER=gemini

# Google Gemini (recommended - fast, vision-capable, JSON mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-compatible endpoint (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Scraper Settings (optional)
# Apify token enables high-volume scraping of public profiles without rate limits.
# If omitted, Wingman falls back to public JSON/HTML endpoints + manual profile text.
APIFY_TOKEN=
INSTAGRAM_ACTOR=apify~instagram-profile-scraper
LINKEDIN_ACTOR=dev_fusion~linkedin-profile-scraper

# Admin key for demo snapshot freezing
ADMIN_KEY=
